# Root drop folder for exam PDFs — user documents, never repo content.
# The README that explains the folder is the one tracked file in it.
/sample/*
!/sample/README.md
# Exported diagnostics logs and Triviadox/ZIP bundles land in the repo root
# when the app runs from here — they are user run data, never repo content.
codox-diagnostics_*.json
*Cx.zip

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example

# Agent-conversion scratch: box/figure crops an agent renders only to LOOK at
# while checking a crop. Not part of the bundle contract (FORMAT.md), so they
# never ship with the exam.
agent-conversion/output-remote/**/preview/
